# Copy this file to .env and fill in what you need. Everything is optional:
# without any keys YC Scout still syncs batches, founders, jobs, website
# contacts and email patterns, and drafts from your templates.

# --- Gemini (AI research, AI-written emails, agent) -------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest
# Web research (Google Search grounding). Free keys have search quota on 2.5 Flash.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
# Requests per minute across the app. Free tier ~10; raise it on a paid key.
GEMINI_RPM=10

# --- Sending email --------------------------------------------------------
# Gmail / Google Workspace: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# Reply / bounce tracking reads your inbox with the same login.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Google Sheets (optional) --------------------------------------------
# 1. Create a service account in Google Cloud, enable the Sheets + Drive APIs,
#    download its JSON key into this folder.
# 2. Create a Google Sheet and share it (Editor) with the service account's
#    client_email from the JSON file.
# 3. Paste the sheet id (the long id in its URL) below.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- Server ------------------------------------------------------------------
YCSCOUT_HOST=127.0.0.1
YCSCOUT_PORT=8000
