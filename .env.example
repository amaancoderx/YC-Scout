# Copy this file to .env and fill in what you need. Everything is optional:
# without any keys YC Scout still syncs batches, founders, jobs, website
# contacts and email patterns, and drafts from your templates.

# --- Gemini (AI research, AI-written emails, agent) -------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Free keys get only ~20 requests/day on 3.5 Flash; when a model's daily quota runs out the app
# skips it until Google resets it and uses the next one.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Web research (Google Search grounding). Free keys have search quota on 2.5 Flash.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
# Requests per minute across the app. Free tier ~10; raise it on a paid key.
GEMINI_RPM=10

# --- Sending email --------------------------------------------------------
# Gmail / Google Workspace: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# Reply / bounce tracking reads your inbox with the same login.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Google Sheets (optional) --------------------------------------------
# 1. Create a service account in Google Cloud, enable the Sheets + Drive APIs,
#    download its JSON key into this folder.
# 2. Create a Google Sheet and share it (Editor) with the service account's
#    client_email from the JSON file.
# 3. Paste the sheet id (the long id in its URL) below.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- Server ------------------------------------------------------------------
YCSCOUT_HOST=127.0.0.1
YCSCOUT_PORT=8000

# --- Login (turn it on whenever the app is reachable by others) -------------
APP_EMAIL=you@example.com
APP_PASSWORD=
# Optional: a long random string; sessions survive restarts when set.
SECRET_KEY=

# --- Cloud database (Turso), needed on hosts without a persistent disk -----
# turso.tech > Create database > copy the URL and create a token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Gmail API sending (for hosts that block SMTP, e.g. Render Free) -------
# See DEPLOY.md step 4, then run: python scout.py gmail-auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Hosted only: paste the full Google service-account JSON here instead of a file.
GOOGLE_SERVICE_ACCOUNT_JSON=
